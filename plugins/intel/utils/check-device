# Run on the GPU host (after a build of //max/mojo/max:max): compile each test
# in tests/device for the B70, check the SPIR-V with utils/check-spirv, run it
# on the GPU with utils/l0/run.sh, and compare its output: printf, print and exp
# (io_math); atomics and math (atomics_math); timers and sleep (timers); MAX
# warp and block primitives (warps); vectors wider than SPIR-V's 16 elements
# (wide). abort() is reported by the driver plugin, so it's tested there
# (LevelZeroLaunchTest, AbortFailsTheNextSynchronize).
set -eu
here=$(cd "$(dirname "$0")/.." && pwd)
modular=${MODULAR_DIR:-$(cd "$here/../.." && pwd)}
plugin=$modular/bazel-bin/plugins/intel/compiler/IntelCompilerPlugin.so
maxpkg=$(cd "$modular" && ./bazelw cquery --output=files //max/mojo/max:max 2>/dev/null)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/out"
cd "$work"
status=0

# check NAME GLOBAL LOCAL COUNT: compile tests/device/NAME.mojo, run its kernel
# and compare the output with expected/NAME.log.
check() {
  name=$1
  if ! MODULAR_COMPILER_PLUGINS=$plugin MODULAR_CACHE_DIR=$work/cache \
    "${INTEL_PLUGIN_BIN:-$HOME/.cache/intel-plugin/bin}/mojo" run -I "$modular/$(dirname "$maxpkg")" \
    "$here/tests/device/$name.mojo" >"$name.mojo.log" 2>&1; then
    cat "$name.mojo.log"
    echo "FAIL: compiling tests/device/$name.mojo"
    status=1
    return
  fi
  "$here/utils/check-spirv" "out/$name.spv" || { status=1; return; }
  if ! "$here/utils/l0/run.sh" "out/$name.spv" "$name(" "$2" "$3" "$4" \
    >"$name.run.log" 2>&1; then
    cat "$name.run.log"
    echo "FAIL: running $name on the GPU"
    status=1
    return
  fi
  if diff -u "expected/$name.log" "$name.run.log"; then
    echo "ok   $name: device output matches"
  else
    echo "FAIL $name: device output differs"
    status=1
  fi
}

mkdir -p expected
cat >expected/io_math.log <<'OUT'
printf: lit v=7
print: v = 7 with a tail longer than eight bytes
buffer[0] = 1096
OUT
cat >expected/atomics_math.log <<'OUT'
