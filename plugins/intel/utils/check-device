buffer[10] = 11
OUT
cat >expected/timers.log <<'OUT'
buffer[0] = 7
buffer[1] = 50
buffer[2] = 1
OUT

check io_math 1 1 1
check atomics_math 256 64 12
check timers 1 1 3
check warps 256 64 14
check wide 1 1 11
exit $status
