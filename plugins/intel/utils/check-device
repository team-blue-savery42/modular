buffer[1] = 1132462080
buffer[2] = 255
buffer[3] = 256
buffer[4] = 1132396544
buffer[5] = 256
buffer[6] = 1414
buffer[7] = 2302585
buffer[8] = 462117
buffer[9] = 2716
buffer[10] = 175
buffer[11] = 16908288
OUT
cat >expected/warps.log <<'OUT'
buffer[0] = 7
buffer[1] = 120
buffer[2] = 3
buffer[3] = 15
buffer[4] = 5
buffer[5] = 21845
buffer[6] = 16
buffer[7] = 15
buffer[8] = 64
buffer[9] = 4369
buffer[10] = 35
buffer[11] = 1
buffer[12] = 5
buffer[13] = 64
OUT
cat >expected/wide.log <<'OUT'
buffer[0] = 7
buffer[1] = 21
buffer[2] = 105
buffer[3] = 105
buffer[4] = 0
buffer[5] = 0
buffer[6] = 0
buffer[7] = 0
