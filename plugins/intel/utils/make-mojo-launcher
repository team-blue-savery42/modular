# Run on the GPU host: write ~/.cache/intel-plugin/bin/mojo, a launcher for the
# source-built mojo that runs in the caller's directory. Bazel's own
# `--script_path` script cds into the runfiles tree, which breaks programs that
# open files relative to $PWD. Re-run after every `bazelw build` that changes
# the build configuration. Extra arguments are passed to bazelw (e.g.
# --config=ci for an optimized build).
set -eu
out=${INTEL_PLUGIN_BIN:-$HOME/.cache/intel-plugin/bin}/mojo
mkdir -p "$(dirname "$out")"
cd "${MODULAR_DIR:-$(dirname "$0")/../../..}"
./bazelw run "$@" --script_path="$out.bazel" //Mojo:mojo >/dev/null 2>&1

runfiles=$(sed -n 's|^cd \(.*\) && \\$|\1|p' "$out.bazel")
[ -n "$runfiles" ] || { echo "make-mojo-launcher: no cd line in $out.bazel" >&2; exit 1; }

# Drop the cd, make runfiles-relative paths absolute, and use the caller's $PWD.
sed -e '/^cd .* && \\$/d' \
    -e "s|=\(bazel-out/[^ ]*\)|=$runfiles/\1|" \
    -e "s|=\(Mojo/[^ ]*\)|=$runfiles/\1|" \
    -e 's|BUILD_WORKING_DIRECTORY=[^ ]*|BUILD_WORKING_DIRECTORY="$PWD"|' \
    -e 's|^  exec env|exec env|' \
    "$out.bazel" > "$out"
chmod +x "$out"
rm -f "$out.bazel"
echo "$out"
