# Check a SPIR-V binary the way the Intel driver will see it :
#   utils/check-spirv <file.spv> [device]
# Runs spirv-val, requires at least one kernel entry point (a truncated module
# can still be valid SPIR-V with none), then compiles it ahead of time with IGC
# through ocloc for `device` (default bmg-g31, the Arc Pro B70) with the driver
# plugin's build options, and prints both sizes.
set -eu
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "usage: $0 <file.spv> [device]" >&2
  exit 2
fi
spv=$1
device=${2:-bmg-g31}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

spirv-val --target-env spv1.4 "$spv"
if ! spirv-dis "$spv" | grep -q 'OpEntryPoint Kernel'; then
  echo "check-spirv: $spv has no kernel entry point" >&2
  exit 1
fi
# The Level Zero plugin's module build options (Module.cpp, kBuildFlags).
ocloc compile -spirv_input -file "$spv" -device "$device" -output "$work/kernel" -q \
  -options "-ze-intel-enable-auto-large-GRF-mode"
native=$(find "$work" -name 'kernel*.bin' | head -n 1)
if [ -z "$native" ]; then
  echo "check-spirv: ocloc produced no binary for $spv" >&2
  exit 1
fi
echo "ok   $spv: SPIR-V $(wc -c < "$spv") bytes, $device binary $(wc -c < "$native") bytes"
