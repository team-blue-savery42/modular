# Run on the GPU host: runs each Mojo program in tests/e2e on the B70 through
# the HAL client (utils/run-e2e) and checks its outcome. These are the ports
# of the stdlib's GPU tests plus the first kernel.
# E2E_ACCELERATOR picks the device (default intel:bmg-g31; intel:rpl-p and
# intel:arl-s are the integrated GPUs): the expectations below follow it where
# the devices differ (DPAS and 2D block I/O, float64, the work-group limit,
# IGC's known miscompiles).
set -u
here=$(cd "$(dirname "$0")/.." && pwd)
device=${E2E_ACCELERATOR:-intel:bmg-g31}
device=${device#intel:}
# xe2: DPAS, 2D block I/O and SPV_KHR_bfloat16 arithmetic hooks; fp64: float64
# kernels compile; maxblock: the largest work-group.
case $device in
  rpl-p) xe2=0 fp64=0 maxblock=512 ;;
  arl-s) xe2=0 fp64=1 maxblock=1024 ;;
  *) xe2=1 fp64=1 maxblock=1024 ;;
esac
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
status=0

# expect NAME EXIT PATTERN...: run tests/e2e/NAME.mojo; its exit code must be
# EXIT (0, or "fail" for any other) and each PATTERN (grep -E) must appear
# the number of times given as COUNT:PATTERN. expect_with OPTIONS NAME ...
# passes OPTIONS (such as -D ASSERT=all) to mojo run.
expect() {
  expect_with "" "$@"
}
skip() {
  echo "skip $1 ($2)"
}

expect_with() {
  opts=$1 name=$2 want=$3
  shift 3
  # shellcheck disable=SC2086 # OPTIONS is a list of words.
  timeout 600 "$here/utils/run-e2e" "$name" $opts >"$work/$name.log" 2>&1
  code=$?
  ok=1
  if [ "$want" = 0 ] && [ $code -ne 0 ]; then ok=0; fi
  if [ "$want" = fail ] && { [ $code -eq 0 ] || [ $code -eq 124 ]; }; then ok=0; fi
  for check in "$@"; do
    count=${check%%:*} pattern=${check#*:}
    got=$(grep -cE "$pattern" "$work/$name.log")
    [ "$got" = "$count" ] || { ok=0; echo "  $name: '$pattern' $got times, expected $count"; }
  done
  if [ $ok = 1 ]; then
    echo "ok   $name"
  else
    echo "FAIL $name (exit $code)"
    grep -avE "warning:|note:|~\^|^ +\^" "$work/$name.log" | tail -15
    status=1
  fi
}

expect vector_add 0 "1:wrong: 0$"
expect scatter 0 "1:PASS test_scatter_global" "1:PASS test_scatter_shared$" \
  "1:PASS test_scatter_shared_masked"
expect shared_gather 0 "1:PASS gather_shared$" "1:PASS gather_shared_masked" \
  "1:PASS strided_load_shared" "1:PASS strided_store_shared"
# Printed once (thread 0 of block 0 of 2 x 32), then the next synchronize
# fails and nothing after it runs.
expect trap fail "1:gpu abort message" "1:a kernel called abort" \
  "0:is never reached"
expect trap_conditional 0 "1:synchronize 0 failed: .*called abort" \
  "1:synchronize 1 failed: .*called abort"
expect from_address_overflow 0 "1:completed without an assertion"
# Two compile-time tables, the named table unfilled (zeros), then filled
# twice through its global_address:/global_size: function properties.
expect constant_memory 0 "5:wrong: 0 first:" "1:^missing global: none$" \
  "1:^global size: 64$" "1:^external \\(filled x2\\) wrong: 0 first: 0.0 2.0 30.0$"
# The same mapping through MAX's DeviceContext (the compat layer):
# each of the three enqueue_function call sites with its own table, a mapping
# shorter than the global, and the two refusals.
expect constant_memory_mapping 0 "6:^PASS .* wrong: 0 first:" "0:^FAIL" \
  "1:^PASS external on a stream wrong: 0 first: 0.0 6.0 90.0$" \
  "1:^PASS partial mapping \(8 of 16\) wrong: 0 first: 100.0 101.0 90.0$" \
  "1:^PASS missing global refused: .*exposes no global .no_such_global." \
  "1:^PASS oversized mapping refused: .*has 128 bytes, but the global has 64\.$" \
  "1:^PASS all$"
# Dynamic shared memory named only in callees: one level, two levels, and
# a kernel that names it too; each block's sum checked on the CPU.
expect shared_memory_callee 0 "4:wrong: 0 first:"
# The math hooks at every width, including those split from wider than 16.
# float16 widths 4 and 8 are wrong with IGC's optimizer on.
if [ $xe2 = 1 ]; then
  expect log2_widths 0 "9:^PASS " "2:^FAIL float16 width (4|8) " "11:^(PASS|FAIL) "
else
  # Xe-LP and Xe-LPG: IGC gets them right.
  expect log2_widths 0 "11:^PASS " "0:^FAIL "
fi
# A failing debug_assert: one whole line per failing work-item, 2 blocks
# of 4, with `%` in the message kept; then the next synchronize fails. Each
# of the 8 work-items exactly once, so a repeated line can't stand in for a
# missing one.
line='^At: .*/debug_assert\.mojo:26:17: block: \[B,0,0\] thread: \[T,0,0\] Assert Error: forcing 100% failure with value 7$'
set --
for b in 0 1; do
  for t in 0 1 2 3; do
    set -- "$@" "1:$(printf '%s\n' "$line" | sed "s/\[B,/[$b,/; s/\[T,/[$t,/")"
  done
done
expect_with "-D ASSERT=all" debug_assert fail \
  "8:^At: .*/debug_assert\.mojo:26:17: " "$@" \
  "1:a kernel called abort" "0:not reached"
# An assertion fails in a callee that returns a value: each of the 2
# work-items prints its message and returns from the caller too, so nothing
# after the call runs, and nothing faults.
expect_with "-D ASSERT=all" assert_in_callee fail \
  "2:^At: .*/assert_in_callee\.mojo:[0-9]+:[0-9]+: block: \[0,0,0\] thread: \[[01],0,0\] Assert Error: index 5 out of range$" \
  "1:thread: \[0,0,0\] Assert Error" "1:thread: \[1,0,0\] Assert Error" \
  "0:went on" "1:a kernel called abort" "0:not reached"
# The index of an enumerate loop, merged through the iterator's Optional phi:
# IGC lost it until the compiler plugin split aggregate phis into scalar
# phis; with bounds checks on, data[i]'s check must pass.
expect bounds_loop 0 "1:^indices 0 1 2 " "1:^ok$"
expect_with "-D ASSERT=all" bounds_loop 0 "1:^indices 0 1 2 " "1:^ok$" \
  "0:Assert Error"
# bfloat16 x ** n as MAX's test_pow_bf16 computes it, bit for bit against the
# host, with IGC's defaults: right since the compiler plugin converts
# bfloat16 with integer operations; 6,849 of 6,912 wrong before.
expect bf16_powi 0 "27:wrong 0 of 256$" "27:far 0 of 256$" "1:^PASS$"
# The conversions themselves, bit for bit against the host: all 65,536
# bfloat16 values to float32, a float32 sample and a float64 sample to
# bfloat16, at widths 1, 4, 8 and 16; with IGC's defaults and with
# -cl-opt-disable. With IGC 2.41's own conversions 295,285 and 377,873 of
# the 393,216 float32 roundings failed at widths 4 and 8 with its defaults,
# and width 16 page-faulted.
set -- "4:^PASS extend w [0-9]+ wrong 0 of 65536$" \
  "4:^PASS round w [0-9]+ wrong 0 of 393216$" \
  "4:^PASS round64 w [0-9]+ wrong 0 of 196608$" "0:^FAIL" "1:^PASS$"
convert_opts=
case $device in
  arl-s)
    # The extensions are exact. Two kinds of rounding differ, and which
    # widths show them varies between runs: Xe-LPG's IGC keeps denormal
    # float32 inputs where the host (and the B70) flush them (0x8001 ->
    # 0x0001, 1528 of 393216), and the float64 roundings differ in the
    # optimized build this device runs (66036 of 196608; the B70's
    # optimized build shows the same, its debug build none).
    set -- "4:^PASS extend w [0-9]+ wrong 0 of 65536$" "0:^FAIL extend" \
      "0:round w [0-9]+ wrong ([0-9]|[0-9][0-9]|[0-9][0-9][0-9]|1[0-4][0-9][0-9]|15[0-1][0-9]|152[0-7]|15[3-9][0-9]|1[6-9][0-9][0-9]|[2-9][0-9][0-9][0-9]) of" \
      "0:round64 w [0-9]+ wrong ([0-9]|[0-9][0-9]|[0-9][0-9][0-9]|[0-9][0-9][0-9][0-9]) of" ;;
  rpl-p)
    # No float64 on Xe-LP: the float64 roundings are left out.
    convert_opts="-D FP64=0"
    set -- "4:^PASS extend w [0-9]+ wrong 0 of 65536$" \
      "4:^PASS round w [0-9]+ wrong 0 of 393216$" "0:^FAIL" "1:^PASS$" ;;
esac
if [ $device = arl-s ]; then
  expect bf16_convert fail "$@"
else
  expect_with "$convert_opts" bf16_convert 0 "$@"
fi
# 128-bit integer products as LLVM leaves them (mul128: a full product, a
# 64 x 64 -> 128 one, and two masked with the 128-bit constant 2^64 - 1) and
# float64 formatting step by step (fp64_steps: dragonbox's 128-bit products
# and sums, and its table of 128-bit constants), device against host, with
# IGC's defaults and with -cl-opt-disable. IGC computes 128-bit integers
# wrongly: before the compiler plugin split them into 64-bit halves, 3 of 4
# mul128 forms and 32 of 112 steps were wrong in both modes.
expect mul128 0 "4:^form [0-3] wrong 0 of 64$" "1:^PASS$"
expect fp64_steps 0 "1:^wrong 0 of 112$" "1:^PASS$"
MOJO_INTEL_IGC_OPTIONS=-cl-opt-disable
export MOJO_INTEL_IGC_OPTIONS
if [ $device = arl-s ]; then
  expect bf16_convert fail "$@"
else
  expect_with "$convert_opts" bf16_convert 0 "$@"
fi
# bf16_powi again with -cl-opt-disable, where IGC goes wrong even without
# its optimizer (selects and phis of bfloat16 wrong once converted): the
# check of the plugin's moves as i16 (988 of 6,912 wrong without them).
expect bf16_powi 0 "27:wrong 0 of 256$" "27:far 0 of 256$" "1:^PASS$"
expect mul128 0 "4:^form [0-3] wrong 0 of 64$" "1:^PASS$"
expect fp64_steps 0 "1:^wrong 0 of 112$" "1:^PASS$"
unset MOJO_INTEL_IGC_OPTIONS
# MAX's test_matmul_1_sram kernel, all of C: the barrier in its tile loop
# must stay convergent, or LLVM unswitches the loop and the edge work-groups'
# work-items wait at different barriers. The race-free variant must be exact;
# MAX's own variant may only show its stride-31 race (see the probe), and
# never in the 10 x 10 corner MAX's test checks.
if [ "$maxblock" -ge 1024 ]; then
  expect matmul_sram 0 "1:^race_free wrong: 0 unexplained: 0 corner: 0$" \
    "1:^max wrong: [0-9]+ unexplained: 0 corner: 0$" \
    "1:^max last column short: [0-9]+ in [0-9]+ of 255 groups" \
    "1:^max first column short: [0-9]+ in [0-9]+ of 17 right-edge groups"
else
  skip matmul_sram "its 32 x 32 tile is a 1024-work-item group"
fi
# The warp primitives MAX's rowwise algorithms use, at every offset and
# lane, and block.sum/max/min up to 1,024 work-items (64 sub-groups: before
# the fix the block reduce read only the first 16 sub-groups' values), with
# partial groups of 16 sub-groups at 272, 320 and 576; fused block reductions
# of 2 and 4 values (topk_fi's), and block.prefix_sum, which before its fix
# was wrong from sub-group 17 on at 512, 576 and 1,024.
if [ "$maxblock" -ge 1024 ]; then
  expect warp_ops 0 "42:^PASS " "0:^FAIL " "1:^PASS shuffle_xor offsets 0-15" \
    "1:^PASS vote " "1:^PASS lane_group_max 4 stride 2$" \
    "1:^PASS block.sum block.max block.min \(both signs\) 272$" \
    "1:^PASS block.sum block.max block.min \(both signs\) 1024$" \
    "1:^PASS block._block_reduce fused 2 and 4 1024$" \
    "1:^PASS block.prefix_sum inclusive exclusive 1024$"
else
  # Without the 576- and 1024-work-item groups (two each of the block,
  # fused and prefix-sum checks).
  expect_with "-D MAX_BLOCK=512" warp_ops 0 "36:^PASS " "0:^FAIL " \
    "1:^PASS shuffle_xor offsets 0-15" "1:^PASS vote " \
    "1:^PASS lane_group_max 4 stride 2$" \
    "1:^PASS block.sum block.max block.min \(both signs\) 272$" \
    "1:^PASS block.sum block.max block.min \(both signs\) 512$" \
    "1:^PASS block._block_reduce fused 2 and 4 272$" \
    "1:^PASS block.prefix_sum inclusive exclusive 512$"
fi
# Kernels that allocate: malloc alone, a List given its capacity, and a
# growing List (List._realloc returns a nested struct, which IGC misread
# before the plugin returned it flat), and realloc from null, growing and
# shrinking, its copies checked; 4,096 work-items each.
expect heap_list 0 "1:^PASS direct 4096 " "1:^PASS list_capacity 4096 " \
  "1:^PASS list 4096 " "1:^PASS realloc 4096 "
# Freed blocks are reused: 64 launches of each kernel, each checked, through
# one context's 8 MiB heap.
expect_with "-D ROUNDS=64" heap_list 0 "4:^PASS [a-z_]+ 4096 work-items 64 rounds"
expect nested_return 0 "1:^PASS nested 256 "
# MAX's test_mandelbrot's kernel: as written, the CPU's float64 sum
# with cx and cy rounded twice; with cx and cy fused, NVIDIA's sum.
if [ $fp64 = 1 ]; then
  expect mandelbrot 0 "1:^PASS as_written sum 4687759364$" \
    "1:^PASS fused sum 4687767697$"
else
  # Xe-LP has no float64, and IGC has no emulation of it.
  expect mandelbrot fail "4:Double type is not supported on this platform"
fi
# MAX's test_strided_load's kernel, through a generic pointer.
expect strided_load 0 "6:^PASS width (4|16) stride [130]$"
# DeviceContext.compute_capability(): the IP version, as the target's
# compute (bmg-g31: 20.2, so 202).
expect compute_capability 0 "1:^PASS compute_capability [0-9]+$"
# The Intel HAL extension's device features, as Level Zero reports them
# for the B70; the test passes when the cached query takes <= 1 us.
case $device in
  rpl-p)
    expect device_features 0 "1:^sub-group sizes: 8 16 32$" "1:^dpas: no$" \
      "1:^dp4a: yes$" "1:^2d block load: no$" "1:^2d block store: no$" \
      "1:^slm per work-group: 65536$" "1:^eus: 80 \(16 x 5 x 1\)$" \
      "1:^PASS device_features$" ;;
  arl-s)
    expect device_features 0 "1:^sub-group sizes: 8 16 32$" "1:^dpas: no$" \
      "1:^dp4a: yes$" "1:^2d block load: no$" "1:^2d block store: no$" \
      "1:^slm per work-group: 65536$" "1:^eus: 64 \(16 x 4 x 1\)$" \
      "1:^PASS device_features$" ;;
  *)
    expect device_features 0 "1:^sub-group sizes: 16 32$" "1:^dpas: yes$" \
      "1:^dp4a: yes$" "1:^2d block load: yes$" "1:^2d block store: yes$" \
      "1:^slm per work-group: 131072$" "1:^eus: 256 \(8 x 4 x 8\)$" \
      "1:^PASS device_features$" ;;
esac
# Sub-group size per kernel: the same warp and block kernels compiled for
# the B70's target and its sub-group size 32 variant, loaded into one
# context; at each size get_sub_group_size(), WARP_SIZE and lane_id agree.
if [ "$maxblock" -ge 1024 ]; then
  expect sub_group_size 0 "28:^PASS " "0:^FAIL " \
    "1:^PASS sub-group size, WARP_SIZE, lane_id at 16$" \
    "1:^PASS sub-group size, WARP_SIZE, lane_id at 32$" \
    "1:^PASS shuffle_xor offsets 0-31 at 32$" \
    "1:^PASS block.sum block.max 1024 at 32$"
else
  expect_with "-D MAX_BLOCK=512" sub_group_size 0 "26:^PASS " "0:^FAIL " \
    "1:^PASS sub-group size, WARP_SIZE, lane_id at 16$" \
    "1:^PASS sub-group size, WARP_SIZE, lane_id at 32$" \
    "1:^PASS shuffle_xor offsets 0-31 at 32$" \
    "1:^PASS block.sum block.max 320 at 32$"
fi
# DPAS through mma(): float16 and bfloat16 inputs, float32 and 16-bit
# accumulators, M = 1, 2, 4, 8, typed and packed B; small integers exact and
# random values within the accumulator's rounding of the CPU's result.
if [ $xe2 = 1 ]; then
  expect mma 0 "37:^PASS " "0:^FAIL " "1:^PASS float16 -> float32 M=8 int " \
    "1:^PASS bfloat16 -> bfloat16 M=1 random " "1:^PASS mma all$"
else
  # No DPAS: IGC refuses the module.
  expect mma fail "1:SPV_INTEL_subgroup_matrix_multiply_accumulate"
fi
# ...and only at sub-group size 16: for the -sg32 target it doesn't compile.
expect mma_sg32 fail \
  "1:constraint failed: Intel DPAS \(mma\) needs sub-group size 16, but this kernel is built for 32" \
  "0:^compiled for sub-group size 32"
# 2D block I/O: every client-extension shape of load, VNNI transform,
# transpose, store and prefetch-then-load, for 8-, 16- and 32-bit elements,
# inside the matrix, off its right and bottom edges (zero fill) and before
# it, against the CPU's model of the layout; and mma() fed by block loads.
if [ $xe2 = 1 ]; then
  expect block_io 0 "354:^PASS " "0:^FAIL " \
    "1:^PASS load_transpose 32-bit 8x32 count 1 edge " \
    "1:^PASS store 16-bit 16x8 edge " \
    "1:^PASS mma with A from block_load and B from block_load_transform wrong: 0" \
    "1:^PASS block_io all$"
else
  expect block_io fail "1:SPV_INTEL_(2d_block_io|subgroup_matrix_multiply_accumulate)"
fi
# ...and a shape the client extension doesn't have, or sub-group size 32,
# doesn't compile.
expect_with "-D CASE=shape" block_io_reject fail \
  "1:constraint failed: no Intel 2D block store of 1 block\(s\) of 16 x 16 2-byte elements" \
  "0:^compiled"
expect_with "-D CASE=sg32" block_io_reject fail \
  "1:constraint failed: Intel 2D block I/O needs sub-group size 16, but this kernel is built for 32" \
  "0:^compiled"
# The Intel GEMM (linalg.matmul.gpu.intel; build
# //max/kernels/src/linalg:linalg first, with --remote_download_outputs=all
# so that the packages it imports are on disk too): float16 and bfloat16 to
# float32 and 16-bit outputs, B row-major and transposed; small integers
# exact, random values within oneMKL's tolerance, at square, transformer-layer
# and edge shapes (M, N, K not multiples of the tiles); both tile classes; the
# skinny kernel for M <= 16; gemm_supported's 2D block I/O limits in bytes
# (7 checks).
if [ $xe2 = 1 ]; then
expect gemm 0 "255:^PASS " "0:^FAIL " "7:^PASS gemm_supported " \
  "1:^PASS float16->float32 B 999x520x328 small wg 256 " \
  "1:^PASS float16->float32 B 999x520x328 small wg 128 " \
  "1:^PASS bfloat16->bfloat16 B\^T 16x4096x4096 random wg 128 " \
  "1:^PASS bfloat16->bfloat16 B\^T 16x4096x4096 random skinny 16 " \
  "1:^PASS float16->float32 B 1x4096x4096 random skinny 8 " \
  "1:^gemm: failures 0$"
else
  expect gemm fail "1:SPV_INTEL_(2d_block_io|subgroup_matrix_multiply_accumulate)"
fi
# MAX's matmul entry point, _matmul_gpu, through DeviceContext (build
# //max/kernels/src/linalg:linalg with --//:hal_device_context=true and
# --remote_download_outputs=all first): its Intel branch for f16/bf16 at
# skinny, small-tile, large and edge shapes, with MAX's store epilogue and
# compute closures, and inputs it declines (float32, an unaligned A), which
# MAX's naive kernel runs.
expect matmul_max 0 "111:^PASS " "0:^FAIL " \
  "1:^PASS float32->float32 B 64x20x64 small " \
  "1:^PASS float32->float32 B 64x96x64 small " \
  "1:^PASS float16->float32 B 64x96x64 small a\+16 " \
  "1:^PASS bfloat16->bfloat16 B\^T 2048x2048x512 small epilogue " \
  "1:^matmul_max: failures 0$"
# MAX's generic GEVM (M = 1, B row-major; float32, which the Intel branch
# declines everywhere): its block held 1024 // warp_size warps, more than
# its lane-group sum spans at sub-group size 16.
expect gevm 0 "5:^PASS " "0:^FAIL " "1:^gevm: failures 0$"
# The Intel FP8-weight kernels (build //max/kernels/src/linalg:linalg with
# --remote_download_outputs=all first):
# every non-NaN float8_e4m3fn code exact, random cases at Qwen3.5-0.8B's
# FP8 shapes through the skinny kernel and the widened GEMM.
if [ $xe2 = 1 ]; then
  expect fp8_matmul 0 "88:^PASS " "0:^FAIL " \
    "1:^PASS f8 float32 16x256x64 one-hot skinny 16 " \
    "1:^PASS f8 bfloat16 512x5120x1024 random wg 256 " \
    "1:^fp8_matmul: failures 0$"
else
  # (Xe-LP: the kernels' bfloat16 arguments ask for SPV_KHR_bfloat16 first.)
  expect fp8_matmul fail "1:SPV_(INTEL_(2d_block_io|subgroup_matrix_multiply_accumulate)|KHR_bfloat16)"
fi
# A kernel argument passed in memory arrives byval.
expect byval_arg 0 "1:^PASS byval$" "1:wrong: 0$"
# MAX's grammar bitmask through DeviceContext (build
# //max/kernels/src/nn:nn with --//:hal_device_context=true first): LLVM's
# SPIR-V backend stopped on its <8 x i32> to <8 x i1> truncation.
expect packed_bitmask 0 "2:^PASS apply_packed_bitmask " "0:^FAIL" \
  "1:^packed_bitmask: failures 0$"
exit $status
