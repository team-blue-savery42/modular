"""Generate stub definitions for HAL entry points a driver plugin doesn't
implement yet.

usage: gen-hal-stubs <modular checkout> <implemented name>... > Stubs.cpp

Reads SDK/include/HAL/M_driver_hal_symbols.inc for the entry points the
conformance suite resolves, finds each one's declaration in the HAL headers,
and writes a definition returning M_DRIVER_STATUS_UNIMPLEMENTED for every name
not listed as implemented. Regenerate whenever the HAL headers change.
"""

import pathlib
import re
import sys


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    hal = pathlib.Path(sys.argv[1]) / "SDK" / "include" / "HAL"
    implemented = set(sys.argv[2:])

    names = re.findall(
        r"^M_DRIVER_HAL_SYMBOL\((\w+)\)",
        (hal / "M_driver_hal_symbols.inc").read_text(),
        re.MULTILINE,
    )
    unknown = implemented - set(names)
    if unknown:
        print(f"gen-hal-stubs: not HAL symbols: {sorted(unknown)}", file=sys.stderr)
        return 1

    declarations = {}
    pattern = re.compile(
        r"M_DRIVER_API_EXPORT\s+M_driver_status_t\s+M_driver_(\w+)\s*\(([^;]*?)\)\s*;",
        re.DOTALL,
    )
    for header in sorted(hal.glob("M_driver_*.h")):
        for match in pattern.finditer(header.read_text()):
            declarations[match.group(1)] = " ".join(match.group(2).split())

    out = [
        "//===----------------------------------------------------------------------===//",
        "// Copyright (c) 2026, Sean Avery. All rights reserved.",
        "//",
        "// Licensed under the Apache License v2.0 with LLVM Exceptions:",
        "// https://llvm.org/LICENSE.txt",
        "//",
        "// Unless required by applicable law or agreed to in writing, software",
        "// distributed under the License is distributed on an \"AS IS\" BASIS,",
        "// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.",
        "// See the License for the specific language governing permissions and",
        "// limitations under the License.",
        "//===----------------------------------------------------------------------===//",
        "//",
        "// GENERATED by plugins/intel/utils/gen-hal-stubs; do not edit by hand.",
        "// HAL entry points the Level Zero plugin doesn't implement yet. The",
        "// conformance suite resolves every HAL symbol, so each must exist.",
        "//",
        "//===----------------------------------------------------------------------===//",
        "",
        '#include "HAL/M_driver_api.h"',
        "",
    ]
    for name in names:
        if name in implemented:
            continue
        params = declarations.get(name)
        if params is None:
            print(f"gen-hal-stubs: no declaration for M_driver_{name}", file=sys.stderr)
            return 1
        unnamed = []
        for param in split_params(params):
            if param in ("", "void"):
                continue
            unnamed.append(f"[[maybe_unused]] {param}")
        out.append(f"M_driver_status_t M_driver_{name}({', '.join(unnamed)}) {{")
        out.append("  return M_DRIVER_STATUS_UNIMPLEMENTED;")
        out.append("}")
        out.append("")
    sys.stdout.write("\n".join(out))
    return 0


def split_params(params: str) -> list[str]:
    """Split on top-level commas (function-pointer parameters nest parens)."""
    parts, depth, current = [], 0, []
    for ch in params:
        if ch == "(":
            depth += 1
        elif ch == ")":
            depth -= 1
        if ch == "," and depth == 0:
            parts.append("".join(current).strip())
            current = []
        else:
            current.append(ch)
    parts.append("".join(current).strip())
    return parts


if __name__ == "__main__":
    sys.exit(main())
