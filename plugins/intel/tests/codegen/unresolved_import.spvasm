; unresolved_import(p): p[0] = mojo_intel_undefined(p[1]), calling a function
; nothing defines: neither the module nor IGC's built-ins. The driver plugin
; must refuse the module and name it (test `UnresolvedImportsAreNamed`); a
; kernel holding a List was that case until the device heap.
; opencl_import.spvasm with the import renamed; assembled with
;   spirv-as tests/codegen/unresolved_import.spvasm \
;     -o plugins/intel/driver/test/data/unresolved_import.spv
               OpCapability Kernel
               OpCapability Addresses
               OpCapability Int64
               OpCapability Int8
               OpCapability Linkage
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %kernel "unresolved_import"
               OpExecutionMode %kernel ContractionOff
               OpName %kernel "unresolved_import"
               OpName %undefined "mojo_intel_undefined"
               OpDecorate %p Alignment 4
               OpDecorate %undefined LinkageAttributes "mojo_intel_undefined" Import
      %uchar = OpTypeInt 8 0
%_ptr_CrossWorkgroup_uchar = OpTypePointer CrossWorkgroup %uchar
       %void = OpTypeVoid
 %kernel_type = OpTypeFunction %void %_ptr_CrossWorkgroup_uchar
      %float = OpTypeFloat 32
   %fn_type = OpTypeFunction %float %float
%_ptr_CrossWorkgroup_float = OpTypePointer CrossWorkgroup %float
      %ulong = OpTypeInt 64 0
    %ulong_4 = OpConstant %ulong 4
  %undefined = OpFunction %float None %fn_type
          %x = OpFunctionParameter %float
               OpFunctionEnd
     %kernel = OpFunction %void None %kernel_type
          %p = OpFunctionParameter %_ptr_CrossWorkgroup_uchar
      %entry = OpLabel
     %second = OpInBoundsPtrAccessChain %_ptr_CrossWorkgroup_uchar %p %ulong_4
    %secondf = OpBitcast %_ptr_CrossWorkgroup_float %second
          %v = OpLoad %float %secondf Aligned 4
          %e = OpFunctionCall %float %undefined %v
     %firstf = OpBitcast %_ptr_CrossWorkgroup_float %p
               OpStore %firstf %e Aligned 4
               OpReturn
               OpFunctionEnd
