; opencl_import(p): p[0] = _Z3expf(p[1]), calling OpenCL's exp by its mangled
; name through an import that IGC resolves from its built-ins. Mojo can't emit
; this one (LLVM's SPIR-V backend lowers OpenCL built-ins it knows to
; OpExtInst), but a built-in only IGC knows would arrive this way. The driver
; plugin must load it (test `MangledBuiltinImportsLoad`). Started from clang
; -target spirv64 output for an OpenCL C kernel; assembled with
;   spirv-as tests/codegen/opencl_import.spvasm \
;     -o plugins/intel/driver/test/data/opencl_import.spv
               OpCapability Kernel
               OpCapability Addresses
               OpCapability Int64
               OpCapability Int8
               OpCapability Linkage
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %kernel "opencl_import"
               OpExecutionMode %kernel ContractionOff
               OpName %kernel "opencl_import"
               OpName %_Z3expf "_Z3expf"
               OpDecorate %p Alignment 4
               OpDecorate %_Z3expf LinkageAttributes "_Z3expf" Import
      %uchar = OpTypeInt 8 0
%_ptr_CrossWorkgroup_uchar = OpTypePointer CrossWorkgroup %uchar
       %void = OpTypeVoid
 %kernel_type = OpTypeFunction %void %_ptr_CrossWorkgroup_uchar
      %float = OpTypeFloat 32
   %exp_type = OpTypeFunction %float %float
%_ptr_CrossWorkgroup_float = OpTypePointer CrossWorkgroup %float
      %ulong = OpTypeInt 64 0
    %ulong_4 = OpConstant %ulong 4
    %_Z3expf = OpFunction %float None %exp_type
          %x = OpFunctionParameter %float
               OpFunctionEnd
     %kernel = OpFunction %void None %kernel_type
          %p = OpFunctionParameter %_ptr_CrossWorkgroup_uchar
      %entry = OpLabel
     %second = OpInBoundsPtrAccessChain %_ptr_CrossWorkgroup_uchar %p %ulong_4
    %secondf = OpBitcast %_ptr_CrossWorkgroup_float %second
          %v = OpLoad %float %secondf Aligned 4
          %e = OpFunctionCall %float %_Z3expf %v
     %firstf = OpBitcast %_ptr_CrossWorkgroup_float %p
               OpStore %firstf %e Aligned 4
               OpReturn
               OpFunctionEnd
