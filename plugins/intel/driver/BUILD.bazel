load("//bazel:api.bzl", "modular_cc_binary", "modular_cc_library", "modular_cc_test")

exports_files(["level_zero_headers.BUILD"])

# HAL driver plugin for Intel GPUs on Level Zero, loaded at run time:
#   MODULAR_DRIVER_PLUGINS=$(bazel-bin)/plugins/intel/driver/LevelZeroPlugin.so
# A plain C ABI against //SDK; the system's libze_loader.so.1 is dlopened.
# Stubs.cpp is generated by ../utils/gen-hal-stubs.
modular_cc_binary(
    # avoids the `lib` prefix; plugins are not traditional libs
    name = "LevelZeroPlugin.so",
    srcs = [
        "ComputeCapability.h",
        "Context.cpp",
        "DeviceFeatures.cpp",
        "Driver.cpp",
        "IntelDeviceFeatures.h",
        "IntelGraphs.h",
        "Limits.cpp",
        "Module.cpp",
        "Plugin.h",
        "Profile.cpp",
        "Profile.h",
        "Stubs.cpp",
        "ZeApi.cpp",
        "ZeApi.h",
    ],
    linkshared = True,
    linkstatic = False,
    visibility = ["//visibility:public"],
    deps = [
        "//SDK:HAL",
        "//Target:Support",
        "@dlpack",
        "@level_zero_headers//:headers",
        "@llvm-project//llvm:Support",
    ],
)

# The compute capability's IP version arithmetic and attribute status, for
# its test.
modular_cc_library(
    name = "ComputeCapability",
    hdrs = ["ComputeCapability.h"],
    includes = ["."],
    deps = ["//SDK:HAL"],
)

# computeCapability and its attribute status over IP versions no installed GPU
# has. Needs no GPU.
modular_cc_test(
    name = "ComputeCapabilityTest",
    size = "small",
    srcs = ["test/ComputeCapabilityTest.cpp"],
    deps = [":ComputeCapability"],
)

# Latency of HAL operations through the plugin; prints, asserts no speed.
modular_cc_test(
    name = "LevelZeroPluginBench",
    size = "medium",
    srcs = ["test/LevelZeroPluginBench.cpp"],
    data = [":LevelZeroPlugin.so"],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :LevelZeroPlugin.so)",
    },
    tags = [
        "gpu",
        "manual",
    ],
    deps = [
        "//Target:DriverPluginTests",
    ],
)

# Modular's HAL conformance suite plus Level Zero specifics. Needs an Intel GPU.
modular_cc_test(
    name = "LevelZeroPluginTest",
    size = "small",
    srcs = [
        "IntelDeviceFeatures.h",
        "IntelGraphs.h",
        "Plugin.h",
        "Profile.h",
        "ZeApi.h",
        "test/LevelZeroAttributeTest.cpp",
        "test/LevelZeroDeviceFeaturesTest.cpp",
        "test/LevelZeroGraphTest.cpp",
        "test/LevelZeroLaunchTest.cpp",
        "test/LevelZeroPluginTest.cpp",
    ],
    data = [
        "test/data/aborts.spv",
        "test/data/boxed_pointer.spv",
        "test/data/constant_import.spv",
        "test/data/divide.spv",
        "test/data/exported_function.spv",
        "test/data/heap_exhaust.spv",
        "test/data/heap_reuse.spv",
        "test/data/opencl_import.spv",
        "test/data/plain_struct.spv",
        "test/data/rejected_array_argument.spv",
        "test/data/reverse_shared.spv",
        "test/data/shared_reduce.spv",
        "test/data/unresolved_import.spv",
        "test/data/uses_heap.spv",
        "test/data/vector_add.spv",
        "test/data/zero_tuple.spv",
        ":LevelZeroPlugin.so",
    ],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :LevelZeroPlugin.so)",
    },
    tags = ["gpu"],
    deps = [
        "//Target:DriverPluginTests",
        "//Target:Support",
        "@level_zero_headers//:headers",
    ],
)

# Launch profiling (MOJO_INTEL_PROFILE): its own binary, since the plugin
# reads the variable once per process. Needs an Intel GPU.
modular_cc_test(
    name = "LevelZeroProfileTest",
    size = "small",
    srcs = [
        "IntelGraphs.h",
        "test/LevelZeroProfileTest.cpp",
    ],
    data = [
        "test/data/vector_add.spv",
        ":LevelZeroPlugin.so",
    ],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :LevelZeroPlugin.so)",
    },
    tags = ["gpu"],
    deps = [
        "//Target:DriverPluginTests",
    ],
)

# A GPU page fault loses the device for the process, and on the B70 the next
# process to use the GPU hangs once (LevelZeroFaultTest.cpp), so this runs
# alone and only when asked. Needs an Intel GPU.
modular_cc_test(
    name = "LevelZeroFaultTest",
    size = "small",
    srcs = ["test/LevelZeroFaultTest.cpp"],
    # The conformance suite links in too; it can't run on a lost device.
    args = ["--gtest_filter=*WaitsFailAfterAGpuFault"],
    data = [
        "test/data/boxed_pointer.spv",
        ":LevelZeroPlugin.so",
    ],
    env = {
        "MODULAR_DRIVER_PLUGINS": "$(location :LevelZeroPlugin.so)",
    },
    tags = [
        "exclusive",
        "gpu",
        "manual",
    ],
    deps = [
        "//Target:DriverPluginTests",
    ],
)
