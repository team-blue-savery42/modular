+// G_PTR_ADD on a pointer that is not a global variable, in a function. Its
+// offset counts bytes, so index an i8 pointer in the result's storage class
+// and cast the result back if it points to another type.
+bool SPIRVInstructionSelector::selectPtrAddOnValue(Register ResVReg,
+                                                   SPIRVTypeInst ResType,
+                                                   MachineInstr &I) const {
+  MachineBasicBlock &BB = *I.getParent();
+  const DebugLoc &DL = I.getDebugLoc();
+  Register Base = I.getOperand(1).getReg();
+  Register Offset = I.getOperand(2).getReg();
+  const bool InBounds = I.getFlag(MachineInstr::InBounds);
+  if (STI.isLogicalSPIRV())
+    return diagnoseUnsupported(
+        I, "pointer arithmetic on a pointer that is not a variable");
+  SPIRVTypeInst ByteType = GR.getOrCreateSPIRVIntegerType(8, I, TII);
+  if (ResType->getOpcode() == SPIRV::OpTypeUntypedPointerKHR) {
+    BuildMI(BB, I, DL,
+            TII.get(InBounds ? SPIRV::OpUntypedInBoundsPtrAccessChainKHR
+                             : SPIRV::OpUntypedPtrAccessChainKHR))
+        .addDef(ResVReg)
+        .addUse(GR.getSPIRVTypeID(ResType))
+        .addUse(GR.getSPIRVTypeID(ByteType))
+        .addUse(Base)
+        .addUse(Offset)
+        .constrainAllUses(TII, TRI, RBI);
+    return true;
+  }
+  SPIRVTypeInst BytePtrType = GR.getOrCreateSPIRVPointerType(
+      Type::getInt8Ty(I.getMF()->getFunction().getContext()), I,
+      GR.getPointerStorageClass(ResType));
+  SPIRVTypeInst BaseType = GR.getSPIRVTypeForVReg(Base);
+  if (!BaseType || BaseType != BytePtrType) {
+    if (BaseType && !GR.isBitcastCompatible(BytePtrType, BaseType))
+      return diagnoseUnsupported(
+          I, "incompatible result and operand types in a bitcast");
+    Register BytePtr = createVirtualRegister(BytePtrType, &GR, MRI, *I.getMF());
+    BuildMI(BB, I, DL, TII.get(SPIRV::OpBitcast))
+        .addDef(BytePtr)
+        .addUse(GR.getSPIRVTypeID(BytePtrType))
+        .addUse(Base)
+        .constrainAllUses(TII, TRI, RBI);
+    Base = BytePtr;
+  }
+  const unsigned Opcode =
+      InBounds ? SPIRV::OpInBoundsPtrAccessChain : SPIRV::OpPtrAccessChain;
+  Register Chain = ResVReg;
+  if (ResType != BytePtrType)
+    Chain = createVirtualRegister(BytePtrType, &GR, MRI, *I.getMF());
+  BuildMI(BB, I, DL, TII.get(Opcode))
+      .addDef(Chain)
+      .addUse(GR.getSPIRVTypeID(BytePtrType))
+      .addUse(Base)
+      .addUse(Offset)
+      .constrainAllUses(TII, TRI, RBI);
+  if (Chain != ResVReg)
+    BuildMI(BB, I, DL, TII.get(SPIRV::OpBitcast))
+        .addDef(ResVReg)
+        .addUse(GR.getSPIRVTypeID(ResType))
+        .addUse(Chain)
+        .constrainAllUses(TII, TRI, RBI);
+  return true;
+}
