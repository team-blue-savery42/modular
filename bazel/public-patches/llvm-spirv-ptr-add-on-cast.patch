diff --git a/llvm/test/CodeGen/SPIRV/pointers/ptr-add-sunk-addrspacecast.ll b/llvm/test/CodeGen/SPIRV/pointers/ptr-add-sunk-addrspacecast.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/pointers/ptr-add-sunk-addrspacecast.ll
@@ -0,0 +1,30 @@
+; CodeGenPrepare sinks the address of %v into block %b as the constant
+; getelementptr (i8, ptr addrspace(4) addrspacecast (ptr addrspace(3) @g to
+; ptr addrspace(4)), i64 24), which reaches instruction selection as a
+; G_PTR_ADD on a G_ADDRSPACE_CAST rather than on a global variable.
+
+; RUN: llc -verify-machineinstrs -mtriple=spirv64-unknown-unknown %s -o - | FileCheck %s
+; RUN: %if spirv-tools %{ llc -mtriple=spirv64-unknown-unknown %s -o - -filetype=obj | spirv-val %}
+
+; CHECK-DAG: %[[#Char:]] = OpTypeInt 8 0
+; CHECK-DAG: %[[#Float:]] = OpTypeFloat 32
+; CHECK-DAG: %[[#GenCharPtr:]] = OpTypePointer Generic %[[#Char]]
+; CHECK-DAG: %[[#GenFloatPtr:]] = OpTypePointer Generic %[[#Float]]
+; CHECK-DAG: %[[#Long:]] = OpTypeInt 64 0
+; CHECK-DAG: %[[#C24:]] = OpConstant %[[#Long]] 24
+; CHECK-DAG: %[[#G:]] = OpVariable %[[#]] Workgroup
+; CHECK: %[[#Cast:]] = OpPtrCastToGeneric %[[#]] %[[#G]]
+; CHECK: %[[#Bytes:]] = OpBitcast %[[#GenCharPtr]] %[[#Cast]]
+; CHECK: %[[#Addr:]] = OpPtrAccessChain %[[#GenCharPtr]] %[[#Bytes]] %[[#C24]]
+; CHECK: %[[#Ptr:]] = OpBitcast %[[#GenFloatPtr]] %[[#Addr]]
+; CHECK: OpLoad %[[#Float]] %[[#Ptr]]
+
+@g = external addrspace(3) global [8 x float]
+
+define spir_kernel void @k(ptr addrspace(1) %out) {
+  br label %b
+b:
+  %v = load float, ptr addrspace(4) inttoptr (i64 add (i64 ptrtoint (ptr addrspace(3) @g to i64), i64 24) to ptr addrspace(4)), align 4
+  store float %v, ptr addrspace(1) %out, align 4
+  ret void
+}
